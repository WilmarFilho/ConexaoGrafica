APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Integrações do Hub Editora (preencher só em produção / .env local) ----
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WEBHOOK_SECRET=
WOO_LOOKBACK_DAYS=3

PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=

ME_TOKEN=
ME_SANDBOX=true
ME_FROM_ZIP=
ME_USER_AGENT="Hub Editora (contato@editora)"

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Melhor Envio: remetente e pacote padrão (ver config/hub.php)
ME_FROM_NAME="Editora"
ME_FROM_PHONE=
ME_FROM_EMAIL=
ME_FROM_DOCUMENT=
ME_FROM_CNPJ=
ME_FROM_ADDRESS=
ME_FROM_NUMBER=
ME_FROM_COMPLEMENT=
ME_FROM_DISTRICT=
ME_FROM_CITY=
ME_FROM_STATE=
ME_SERVICES=1,2,3,17
ME_NON_COMMERCIAL=true
ME_DEFAULT_WEIGHT_G=350
ME_DEFAULT_WIDTH_CM=16
ME_DEFAULT_HEIGHT_CM=23
ME_DEFAULT_DEPTH_CM=3

# Amazon SP-API (app privado no Seller Central; opcional, a tela Integrações também aceita)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# Backup diário cifrado fora do servidor (hub:backup). Chave: php artisan hub:backup --gerar-chave
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# true para Supabase Storage (endpoint https://<ref>.storage.supabase.co/storage/v1/s3)
BACKUP_S3_PATH_STYLE=false
BACKUP_RETENTION_DAYS=14
# Dados pessoais de compradores da Amazon: apagados N dias após o envio (máximo 30; com backups de 14 dias, use 15)
AMAZON_PII_RETENTION_DAYS=15

# Importação de PDF com IA (Conexão DOI, OpenAI). Sem OPENAI_API_KEY o comando só avisa.
OPENAI_API_KEY=
HUB_AI_MODEL=gpt-6-astra
HUB_AI_EFFORT=medium
HUB_AI_FRONT_MATTER_PAGES=30
HUB_AI_MAX_CHAPTER_TOKENS=60000
HUB_GS_BIN=gs

# Conexão DOI: site público (plugin conexao-doi) e segredo compartilhado de 64 caracteres (igual ao wp-config.php)
CONEXAO_DOI_WP_URL=
CONEXAO_DOI_WP_SECRET=

# Conexão DOI — depósito na Crossref (App\Crossref). CROSSREF_ENV=test envia para test.crossref.org.
# CROSSREF_LOGIN no formato e-mail/role (role bcfg). CROSSREF_PREFIX é o prefixo real da editora
# (10.68564); o padrão 10.00000 do config é só exemplo.
CROSSREF_ENV=test
CROSSREF_LOGIN=
CROSSREF_PASSWORD=
CROSSREF_PREFIX=
CROSSREF_DEPOSITOR_NAME=
CROSSREF_DEPOSITOR_EMAIL=
CROSSREF_REGISTRANT=
CROSSREF_LANDING_BASE=
